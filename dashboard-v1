                </div>
                <span class="status ok">Active</span>
              </div>

              <div class="list-item">
                <div>
                  <strong>Admin</strong>
                  <small>anasl.lm20@gmail.com</small>
                </div>
                <span class="status info">Admin</span>
              </div>

              <div class="list-item">
                <div>
                  <strong>Agent</strong>
