<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <base target="_top">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>VALUEMART Dashboard</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    :root {
      --bg: #07111f;
      --panel: #0c1728;
      --panel-2: #101d32;
      --panel-3: #13233c;
      --text: #f7fbff;
      --muted: #8fa3bf;
      --line: rgba(255,255,255,.08);
      --brand: #7c3aed;
      --brand-2: #22c55e;
      --danger: #ef4444;
      --warning: #f59e0b;
      --info: #38bdf8;
      --white: #ffffff;
      --shadow: 0 24px 70px rgba(0,0,0,.35);
      --radius: 22px;
    }

    [data-theme="light"] {
      --bg: #f4f7fb;
      --panel: #ffffff;
      --panel-2: #ffffff;
      --panel-3: #eef3fb;
      --text: #101827;
      --muted: #64748b;
      --line: rgba(15,23,42,.1);
      --shadow: 0 20px 50px rgba(15,23,42,.1);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: "Cairo", sans-serif;
      background:
        radial-gradient(circle at 10% 0%, rgba(124,58,237,.22), transparent 30%),
        radial-gradient(circle at 90% 20%, rgba(34,197,94,.14), transparent 28%),
        var(--bg);
      color: var(--text);
      min-height: 100vh;
      overflow-x: hidden;
    }

    button, input, select, textarea {
      font-family: inherit;
    }

    .app {
      display: grid;
      grid-template-columns: 290px 1fr;
      min-height: 100vh;
    }

    .sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      background: rgba(12,23,40,.88);
      backdrop-filter: blur(18px);
      border-left: 1px solid var(--line);
      padding: 22px;
      overflow-y: auto;
      z-index: 30;
    }

    [data-theme="light"] .sidebar {
      background: rgba(255,255,255,.86);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 26px;
    }

    .brand-logo {
      width: 48px;
      height: 48px;
      border-radius: 18px;
      background: linear-gradient(135deg, var(--brand), #ec4899);
      display: grid;
      place-items: center;
      font-weight: 900;
      color: white;
      box-shadow: 0 12px 35px rgba(124,58,237,.35);
    }

    .brand h1 {
      margin: 0;
      font-size: 20px;
      line-height: 1.1;
      letter-spacing: .5px;
    }

    .brand p {
      margin: 3px 0 0;
      color: var(--muted);
      font-size: 12px;
    }

    .nav-title {
      font-size: 12px;
      color: var(--muted);
      margin: 22px 8px 10px;
      font-weight: 800;
    }

    .nav-btn {
      width: 100%;
      border: 0;
      background: transparent;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      border-radius: 16px;
      cursor: pointer;
      font-size: 14px;
      font-weight: 800;
      transition: .2s ease;
      text-align: right;
      margin-bottom: 7px;
    }

    .nav-btn:hover,
    .nav-btn.active {
      background: linear-gradient(135deg, rgba(124,58,237,.18), rgba(56,189,248,.08));
      color: var(--text);
    }

    .nav-icon {
      width: 30px;
      height: 30px;
      border-radius: 12px;
      background: var(--panel-3);
      display: grid;
      place-items: center;
      flex: 0 0 auto;
    }

    .main {
      padding: 24px;
      min-width: 0;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 22px;
      position: sticky;
      top: 0;
      z-index: 20;
      background: linear-gradient(to bottom, var(--bg) 70%, transparent);
      padding: 0 0 12px;
    }

    .page-title h2 {
      margin: 0;
      font-size: 30px;
      line-height: 1.1;
    }

    .page-title p {
      margin: 8px 0 0;
      color: var(--muted);
      font-size: 14px;
    }

    .top-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .pill {
      border: 1px solid var(--line);
      background: rgba(255,255,255,.04);
      color: var(--text);
      border-radius: 999px;
      padding: 10px 14px;
      display: inline-flex;
      align-items: center;
      gap: 9px;
      font-size: 13px;
      font-weight: 800;
    }

    .btn {
      border: 0;
      background: var(--panel-3);
      color: var(--text);
      border-radius: 14px;
      padding: 10px 14px;
      cursor: pointer;
      font-weight: 900;
      transition: .18s;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .btn:hover {
      transform: translateY(-1px);
      filter: brightness(1.08);
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--brand), #2563eb);
      color: white;
    }

    .btn-success {
      background: rgba(34,197,94,.18);
      color: #4ade80;
    }

    .btn-danger {
      background: rgba(239,68,68,.18);
      color: #fb7185;
    }

    .btn-warning {
      background: rgba(245,158,11,.18);
      color: #fbbf24;
    }

    .btn-info {
      background: rgba(56,189,248,.18);
      color: #67e8f9;
    }

    .grid {
      display: grid;
      gap: 16px;
    }

    .stats-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .two-grid {
      grid-template-columns: 1.4fr .9fr;
    }

    .three-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .card {
      background: linear-gradient(180deg, rgba(255,255,255,.045), rgba(255,255,255,.018)), var(--panel);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 18px;
      min-width: 0;
    }

    .stat {
      min-height: 138px;
      position: relative;
      overflow: hidden;
    }

    .stat:after {
      content: "";
      position: absolute;
      width: 110px;
      height: 110px;
      border-radius: 50%;
      background: rgba(124,58,237,.15);
      left: -35px;
      bottom: -40px;
    }

    .stat-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      position: relative;
      z-index: 1;
    }

    .stat-icon {
      width: 44px;
      height: 44px;
      border-radius: 16px;
      background: var(--panel-3);
      display: grid;
      place-items: center;
      font-size: 20px;
    }

    .stat-label {
      color: var(--muted);
      font-size: 13px;
      margin: 0;
      font-weight: 800;
    }

    .stat-value {
      margin: 15px 0 0;
      font-size: 30px;
      font-weight: 900;
      letter-spacing: .3px;
      position: relative;
      z-index: 1;
    }

    .stat-small {
      margin: 6px 0 0;
      color: var(--muted);
      font-size: 12px;
      position: relative;
      z-index: 1;
    }

    .section-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 14px;
    }

    .section-head h3 {
      margin: 0;
      font-size: 18px;
    }

    .section-head span {
      color: var(--muted);
      font-size: 12px;
      font-weight: 800;
    }

    .table-wrap {
      overflow: auto;
      border-radius: 18px;
      border: 1px solid var(--line);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 980px;
      background: rgba(255,255,255,.015);
    }

    th, td {
      padding: 13px 12px;
      border-bottom: 1px solid var(--line);
      text-align: right;
      font-size: 13px;
      white-space: nowrap;
    }

    th {
      color: var(--muted);
      background: rgba(255,255,255,.035);
      font-size: 12px;
      font-weight: 900;
    }

    tr:hover td {
      background: rgba(124,58,237,.055);
    }

    .status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 900;
      border: 1px solid var(--line);
      max-width: 180px;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .status.ok {
      background: rgba(34,197,94,.13);
      color: #4ade80;
    }

    .status.bad {
      background: rgba(239,68,68,.13);
      color: #fb7185;
    }

    .status.wait {
      background: rgba(245,158,11,.13);
      color: #fbbf24;
    }

    .status.info {
      background: rgba(56,189,248,.13);
      color: #67e8f9;
    }

    .filters {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 14px;
    }

    .input {
      background: var(--panel-2);
      color: var(--text);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 11px 13px;
      min-height: 42px;
      outline: 0;
      font-weight: 700;
    }

    .input:focus {
      border-color: rgba(124,58,237,.65);
      box-shadow: 0 0 0 3px rgba(124,58,237,.13);
    }

    .list {
      display: grid;
      gap: 10px;
    }

    .list-item {
      border: 1px solid var(--line);
      background: rgba(255,255,255,.025);
      padding: 12px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .list-item strong {
      display: block;
      font-size: 14px;
    }

    .list-item small {
      color: var(--muted);
      font-weight: 800;
    }

    .bar {
      height: 9px;
      background: var(--panel-3);
      border-radius: 999px;
      overflow: hidden;
      margin-top: 8px;
    }

    .bar i {
      display: block;
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--brand), var(--info));
      border-radius: inherit;
    }

    .page {
      display: none;
      animation: fade .18s ease;
    }

    .page.active {
      display: block;
    }

    @keyframes fade {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .products-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .product-card {
      overflow: hidden;
      padding: 0;
    }

    .product-img {
      height: 170px;
      background:
        linear-gradient(135deg, rgba(124,58,237,.22), rgba(34,197,94,.11)),
        var(--panel-3);
      display: grid;
      place-items: center;
      color: var(--muted);
      font-weight: 900;
      position: relative;
      overflow: hidden;
    }

    .product-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .product-body {
      padding: 15px;
    }

    .product-body h4 {
      margin: 0 0 10px;
      font-size: 15px;
      min-height: 40px;
    }

    .mini-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }

    .mini {
      background: rgba(255,255,255,.035);
      border: 1px solid var(--line);
      border-radius: 13px;
      padding: 8px;
      text-align: center;
    }

    .mini strong {
      display: block;
      font-size: 16px;
    }

    .mini small {
      color: var(--muted);
      font-size: 11px;
      font-weight: 800;
    }

    .calendar-layout {
      display: grid;
      grid-template-columns: 1fr 360px;
      gap: 16px;
    }

    .calendar-grid {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 10px;
    }

    .day-name {
      color: var(--muted);
      font-weight: 900;
      text-align: center;
      font-size: 12px;
      padding: 8px 0;
    }

    .day {
      min-height: 112px;
      background: rgba(255,255,255,.026);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 10px;
      cursor: pointer;
      transition: .18s;
    }

    .day:hover,
    .day.active {
      background: rgba(124,58,237,.12);
      border-color: rgba(124,58,237,.4);
    }

    .day.empty {
      opacity: .3;
      cursor: default;
    }

    .day-num {
      font-weight: 900;
      margin-bottom: 7px;
    }

    .day-count {
      display: inline-flex;
      background: rgba(34,197,94,.16);
      color: #4ade80;
      padding: 4px 8px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 900;
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.58);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 18px;
      z-index: 100;
    }

    .modal-backdrop.show {
      display: flex;
    }

    .modal {
      width: min(820px, 100%);
      max-height: 90vh;
      overflow: auto;
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 24px;
      box-shadow: var(--shadow);
      padding: 18px;
    }

    .toast-wrap {
      position: fixed;
      left: 18px;
      bottom: 18px;
      display: grid;
      gap: 10px;
      z-index: 200;
    }

    .toast {
      width: min(360px, calc(100vw - 36px));
      background: var(--panel);
      border: 1px solid var(--line);
      box-shadow: var(--shadow);
      border-radius: 18px;
      padding: 13px;
      display: flex;
      gap: 10px;
      align-items: flex-start;
    }

    .toast b {
      display: block;
      font-size: 14px;
    }

    .toast span {
      display: block;
      color: var(--muted);
      font-size: 12px;
      margin-top: 3px;
    }

    .badge {
      background: var(--danger);
      color: white;
      border-radius: 999px;
      padding: 2px 7px;
      font-size: 11px;
      font-weight: 900;
      margin-right: auto;
    }

    .access-screen,
    .loading-screen {
      position: fixed;
      inset: 0;
      display: grid;
      place-items: center;
      background:
        radial-gradient(circle at 30% 10%, rgba(124,58,237,.22), transparent 30%),
        var(--bg);
      z-index: 300;
      padding: 20px;
    }

    .access-card {
      width: min(520px, 100%);
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 28px;
      padding: 28px;
      box-shadow: var(--shadow);
      text-align: center;
    }

    .loader {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      border: 4px solid rgba(255,255,255,.12);
      border-top-color: var(--brand);
      animation: spin .8s linear infinite;
      margin: 0 auto 14px;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .mobile-menu {
      display: none;
    }

    @media (max-width: 1150px) {
      .stats-grid,
      .products-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .two-grid,
      .calendar-layout {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 820px) {
      .app {
        grid-template-columns: 1fr;
      }

      .sidebar {
        position: fixed;
        right: 0;
        top: 0;
        width: 290px;
        transform: translateX(105%);
        transition: .2s;
      }

      .sidebar.open {
        transform: translateX(0);
      }

      .main {
        padding: 16px;
      }

      .mobile-menu {
        display: inline-flex;
      }

      .topbar {
        align-items: flex-start;
      }

      .stats-grid,
      .three-grid,
      .products-grid {
        grid-template-columns: 1fr;
      }

      .page-title h2 {
        font-size: 24px;
      }

      .calendar-grid {
        gap: 6px;
      }

      .day {
        min-height: 82px;
        padding: 7px;
      }
    }
  </style>
</head>

<body data-theme="dark">
  <div id="loading" class="loading-screen">
    <div class="access-card">
      <div class="loader"></div>
      <h2>كنوجد Dashboard ديال VALUEMART...</h2>
      <p style="color:var(--muted);margin:0">كنربط مع Google Sheet وكنتحقق من login.</p>
    </div>
  </div>

  <div id="accessDenied" class="access-screen" style="display:none">
    <div class="access-card">
      <div style="font-size:48px">🔒</div>
      <h2>Access denied</h2>
      <p style="color:var(--muted)">
        هاد الحساب ما عندوش الصلاحية يدخل للداشبورد.
      </p>
      <p class="pill" style="justify-content:center">
        Email: <span id="deniedEmail">Unknown</span>
      </p>
    </div>
  </div>

  <div class="app" id="app" style="display:none">
    <aside class="sidebar" id="sidebar">
      <div class="brand">
        <div class="brand-logo">VM</div>
        <div>
          <h1>VALUEMART</h1>
          <p>Orders Control Center</p>
        </div>
      </div>

      <div class="nav-title">القائمة</div>

      <button class="nav-btn active" data-page="dashboard">
        <span class="nav-icon">📊</span>
        Dashboard
      </button>

      <button class="nav-btn" data-page="orders">
        <span class="nav-icon">📦</span>
        Orders
      </button>

      <button class="nav-btn" data-page="calendar">
        <span class="nav-icon">📅</span>
        Calendar
      </button>

      <button class="nav-btn" data-page="products">
        <span class="nav-icon">👗</span>
        Products
      </button>

      <button class="nav-btn" data-page="notifications">
        <span class="nav-icon">🔔</span>
        Notifications
        <span id="notifBadge" class="badge" style="display:none">0</span>
      </button>

      <div class="nav-title">الحساب</div>

      <button class="nav-btn" data-page="profile">
        <span class="nav-icon">👤</span>
        Profile
      </button>

      <button class="nav-btn" data-page="settings">
        <span class="nav-icon">⚙️</span>
        Settings
      </button>
    </aside>

    <main class="main">
      <div class="topbar">
        <button class="btn mobile-menu" onclick="toggleSidebar()">☰</button>

        <div class="page-title">
          <h2 id="pageTitle">Dashboard</h2>
          <p id="pageSubtitle">نظرة عامة على الأداء والطلبات</p>
        </div>

        <div class="top-actions">
          <span class="pill">🟢 Realtime <span id="rtSec">5s</span></span>
          <span class="pill">👤 <span id="topUser">...</span></span>
          <button class="btn" onclick="toggleTheme()">🌗 Theme</button>
          <button class="btn btn-primary" onclick="refreshAll()">↻ Refresh</button>
        </div>
      </div>

      <section id="page-dashboard" class="page active">
        <div class="grid stats-grid" id="statsGrid"></div>

        <div class="grid two-grid" style="margin-top:16px">
          <div class="card">
            <div class="section-head">
              <div>
                <h3>Orders by day</h3>
                <span>عدد الطلبات حسب الأيام</span>
              </div>
            </div>
            <canvas id="ordersChart" height="110"></canvas>
          </div>

          <div class="card">
            <div class="section-head">
              <div>
                <h3>Top Cities</h3>
                <span>أكثر المدن طلباً</span>
              </div>
            </div>
            <div id="topCities" class="list"></div>
          </div>
        </div>

        <div class="grid two-grid" style="margin-top:16px">
          <div class="card">
            <div class="section-head">
              <div>
                <h3>Recent Orders</h3>
                <span>آخر الطلبات</span>
              </div>
              <button class="btn btn-primary" onclick="goPage('orders')">شوف الكل</button>
            </div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Order ID</th>
                    <th>الاسم</th>
                    <th>المدينة</th>
                    <th>المنتج</th>
                    <th>الثمن</th>
                    <th>Confirmation</th>
                    <th>Delivery</th>
                  </tr>
                </thead>
                <tbody id="recentOrdersBody"></tbody>
              </table>
            </div>
          </div>

          <div class="card">
            <div class="section-head">
              <div>
                <h3>Top Products</h3>
                <span>أفضل المنتجات</span>
              </div>
            </div>
            <div id="topProducts" class="list"></div>
          </div>
        </div>
      </section>

      <section id="page-orders" class="page">
        <div class="card">
          <div class="section-head">
            <div>
              <h3>Youcan Orders</h3>
              <span>هنا كتقدر تبدل status مباشرة فـ Sheet</span>
            </div>
            <button class="btn btn-primary" onclick="loadOrders()">↻ تحديث</button>
          </div>

          <div class="filters">
            <input id="orderSearch" class="input" placeholder="بحث: الاسم، الهاتف، المدينة، المنتج..." oninput="debouncedLoadOrders()">
            <select id="orderStatus" class="input" onchange="loadOrders()">
              <option value="">كل الحالات</option>
              <option value="confirmer">Confirmer</option>
              <option value="annuler">Annuler</option>
              <option value="pas de">Pas de réponse</option>
              <option value="liv">Livrée</option>
              <option value="report">Reportée</option>
            </select>
