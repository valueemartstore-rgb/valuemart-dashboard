    </main>
  </div>

  <div class="modal-backdrop" id="modalBackdrop" onclick="closeModal(event)">
    <div class="modal" id="modal"></div>
  </div>

  <div class="toast-wrap" id="toastWrap"></div>

  <script>
    const STATE = {
      user: null,
      config: { storeName: "VALUEMART", currency: "DH", realtimeSeconds: 5 },
      dashboard: null,
      orders: [],
      calendarDays: [],
      products: [],
      currentPage: "dashboard",
      currentMonth: new Date(),
      selectedDate: null,
      seenLatestOrderId: localStorage.getItem("vm_seen_latest_order") || "",
      realtimeTimer: null,
      chart: null,
      debounce: null
    };

    function api(type, params = {}) {
      return new Promise((resolve, reject) => {
        google.script.run
          .withSuccessHandler(resolve)
          .withFailureHandler(reject)
          .handleApi({ parameter: { type, ...params } });
      });
    }

    async function init() {
      try {
        const me = await api("me");

        if (!me.success || !me.user || !me.user.loggedIn) {
          showAccessDenied(me.user);
          return;
        }

        STATE.user = me.user;
        STATE.config = me.config || STATE.config;

        document.getElementById("topUser").textContent = `${STATE.user.name} • ${STATE.user.role}`;
        document.getElementById("rtSec").textContent = `${STATE.config.realtimeSeconds}s`;
        document.getElementById("profileName").textContent = STATE.user.name;
        document.getElementById("profileEmail").textContent = STATE.user.email;
        document.getElementById("profileRole").textContent = STATE.user.role;
        document.getElementById("profileStore").textContent = STATE.user.store || STATE.config.storeName;
        document.getElementById("profileRt").textContent = STATE.config.realtimeSeconds;

        document.getElementById("loading").style.display = "none";
        document.getElementById("app").style.display = "";

        setupNav();
        await refreshAll();
        startRealtime();

      } catch (err) {
        document.getElementById("loading").style.display = "none";
        document.getElementById("accessDenied").style.display = "grid";
        document.getElementById("deniedEmail").textContent = "Error: " + err.message;
      }
    }

    function showAccessDenied(user) {
      document.getElementById("loading").style.display = "none";
      document.getElementById("accessDenied").style.display = "grid";
      document.getElementById("deniedEmail").textContent = user && user.email ? user.email : "Unknown";
    }

    function setupNav() {
      document.querySelectorAll(".nav-btn[data-page]").forEach(btn => {
        btn.addEventListener("click", () => goPage(btn.dataset.page));
      });
    }

    function goPage(page) {
      STATE.currentPage = page;

      document.querySelectorAll(".page").forEach(p => p.classList.remove("active"));
      document.getElementById("page-" + page).classList.add("active");

      document.querySelectorAll(".nav-btn").forEach(b => b.classList.remove("active"));
      document.querySelector(`.nav-btn[data-page="${page}"]`).classList.add("active");

      const titles = {
        dashboard: ["Dashboard", "نظرة عامة على الأداء والطلبات"],
        orders: ["Orders", "تعديل ومراقبة طلبات Youcan"],
        calendar: ["Calendar", "شوف الطلبات حسب الأيام والشهور"],
        products: ["Products", "أداء المنتجات والصور"],
        notifications: ["Notifications", "آخر الطلبات والتنبيهات"],
        profile: ["Profile", "معلومات الحساب"],
        settings: ["Settings", "إعدادات النظام"]
      };

      document.getElementById("pageTitle").textContent = titles[page][0];
      document.getElementById("pageSubtitle").textContent = titles[page][1];

      if (page === "orders") loadOrders();
      if (page === "calendar") loadCalendar();
      if (page === "products") loadProducts();
      if (page === "notifications") loadNotifications();

      document.getElementById("sidebar").classList.remove("open");
    }

    function toggleSidebar() {
      document.getElementById("sidebar").classList.toggle("open");
    }

    async function refreshAll() {
      await loadDashboard();

      if (STATE.currentPage === "orders") await loadOrders();
      if (STATE.currentPage === "calendar") await loadCalendar();
      if (STATE.currentPage === "products") await loadProducts();
      if (STATE.currentPage === "notifications") await loadNotifications();
    }

    function startRealtime() {
      clearInterval(STATE.realtimeTimer);
      STATE.realtimeTimer = setInterval(async () => {
        await loadDashboard(true);

        if (STATE.currentPage === "orders") await loadOrders(true);
        if (STATE.currentPage === "calendar") await loadCalendar(true);
        if (STATE.currentPage === "products") await loadProducts(true);
        if (STATE.currentPage === "notifications") await loadNotifications(true);
      }, (STATE.config.realtimeSeconds || 5) * 1000);
    }

    async function loadDashboard(silent = false) {
      const data = await api("dashboard");
      if (!data.success) return toast("Error", data.error || "Dashboard error");

      const oldLatest = STATE.dashboard && STATE.dashboard.orders && STATE.dashboard.orders[0] ? STATE.dashboard.orders[0].id : "";
      const newLatest = data.orders && data.orders[0] ? data.orders[0].id : "";

      STATE.dashboard = data;

      renderStats(data.summary);
      renderChart(data.summary.ordersByDay || []);
      renderTopList("topCities", data.summary.topCities || []);
      renderTopList("topProducts", data.summary.topProducts || []);
      renderRecentOrders(data.orders || []);

      if (newLatest && STATE.seenLatestOrderId && newLatest !== STATE.seenLatestOrderId && !silent) {
        notifyNewOrder(data.orders[0]);
      }

      if (newLatest && oldLatest && newLatest !== oldLatest) {
        notifyNewOrder(data.orders[0]);
      }

      if (newLatest) {
        STATE.seenLatestOrderId = newLatest;
        localStorage.setItem("vm_seen_latest_order", newLatest);
      }
    }

    function renderStats(s) {
      const money = STATE.config.currency || "DH";
      const stats = [
        ["📦", "Total Orders", s.totalOrders, "مجموع الطلبات"],
        ["✅", "Confirmed", s.confirmed, percent(s.confirmationRate) + " confirmation"],
        ["❌", "Cancelled", s.cancelled, "طلبات ملغية"],
        ["📵", "No Response", s.noResponse, "ما جاوبوش"],
        ["🚚", "Delivered", s.delivered, percent(s.deliveryRate) + " delivery"],
        ["💰", "Revenue Confirmed", formatNum(s.revenueConfirmed) + " " + money, "دخل confirmed"],
        ["🏁", "Revenue Delivered", formatNum(s.revenueDelivered) + " " + money, "دخل delivered"],
        ["🛒", "AOV", formatNum(s.aov) + " " + money, "متوسط الطلب"]
      ];

      document.getElementById("statsGrid").innerHTML = stats.map(x => `
        <div class="card stat">
          <div class="stat-head">
            <div>
              <p class="stat-label">${x[1]}</p>
              <div class="stat-value">${x[2]}</div>
              <p class="stat-small">${x[3]}</p>
            </div>
            <div class="stat-icon">${x[0]}</div>
          </div>
        </div>
      `).join("");
    }

    function renderChart(rows) {
      const ctx = document.getElementById("ordersChart");

      const labels = rows.slice(-14).map(r => r.date);
      const values = rows.slice(-14).map(r => r.count);

      if (STATE.chart) STATE.chart.destroy();

      STATE.chart = new Chart(ctx, {
        type: "line",
        data: {
          labels,
          datasets: [{
            label: "Orders",
            data: values,
            fill: true,
            tension: .42,
            borderWidth: 3
          }]
        },
        options: {
          responsive: true,
          plugins: {
            legend: { display: false }
          },
          scales: {
            x: { ticks: { color: getMuted() }, grid: { color: "rgba(255,255,255,.06)" } },
            y: { ticks: { color: getMuted() }, grid: { color: "rgba(255,255,255,.06)" }, beginAtZero: true }
          }
        }
      });
    }

    function renderTopList(id, rows) {
      const max = Math.max(...rows.map(r => r.count), 1);

      document.getElementById(id).innerHTML = rows.length ? rows.map(r => `
        <div class="list-item">
          <div style="width:100%">
            <div style="display:flex;justify-content:space-between;gap:10px">
              <strong>${escapeHtml(r.name)}</strong>
              <small>${r.count}</small>
            </div>
            <div class="bar"><i style="width:${Math.round((r.count / max) * 100)}%"></i></div>
          </div>
        </div>
      `).join("") : empty("ما كايناش data");
    }

    function renderRecentOrders(rows) {
      document.getElementById("recentOrdersBody").innerHTML = rows.length ? rows.map(o => `
        <tr onclick="openOrder('${o.id}')" style="cursor:pointer">
          <td><b>${o.id}</b></td>
          <td>${escapeHtml(o.name)}</td>
          <td>${escapeHtml(o.city)}</td>
          <td>${escapeHtml(o.product)}</td>
          <td>${formatNum(o.price)} ${STATE.config.currency}</td>
          <td>${statusBadge(o.confirmation)}</td>
          <td>${statusBadge(o.delivered)}</td>
        </tr>
      `).join("") : `<tr><td colspan="7">${empty("ما كايناش orders")}</td></tr>`;
    }

    async function loadOrders(silent = false) {
      const q = document.getElementById("orderSearch") ? document.getElementById("orderSearch").value : "";
      const status = document.getElementById("orderStatus") ? document.getElementById("orderStatus").value : "";
      const start = document.getElementById("startDate") ? document.getElementById("startDate").value : "";
      const end = document.getElementById("endDate") ? document.getElementById("endDate").value : "";

      const data = await api("orders", { q, status, start, end });
      if (!data.success) return toast("Error", data.error || "Orders error");

      STATE.orders = data.orders || [];
      renderOrdersTable(STATE.orders);
    }

    function debouncedLoadOrders() {
      clearTimeout(STATE.debounce);
      STATE.debounce = setTimeout(loadOrders, 350);
    }

    function renderOrdersTable(rows) {
      document.getElementById("ordersBody").innerHTML = rows.length ? rows.map(o => `
        <tr>
          <td><b>${o.id}</b></td>
          <td>${formatDate(o.date)}</td>
          <td>${escapeHtml(o.name)}</td>
          <td><b>${escapeHtml(o.phone)}</b></td>
          <td>${escapeHtml(o.city)}</td>
          <td>${escapeHtml(o.product)}</td>
          <td>${escapeHtml(o.variant)}</td>
          <td>${formatNum(o.price)} ${STATE.config.currency}</td>
          <td>${statusBadge(o.confirmation)}</td>
          <td>${statusBadge(o.delivered)}</td>
          <td>
            <button class="btn btn-success" onclick="updateStatus('${o.id}','Confirmation','Confirmer')">Confirmer</button>
            <button class="btn btn-danger" onclick="updateStatus('${o.id}','Confirmation','Annuler')">Annuler</button>
            <button class="btn btn-warning" onclick="updateStatus('${o.id}','Confirmation','Pas de réponse')">No response</button>
            <button class="btn btn-info" onclick="updateStatus('${o.id}','Delivred','Livrée')">Livrée</button>
            <button class="btn btn-warning" onclick="updateStatus('${o.id}','Delivred','Reportée')">Reportée</button>
            <button class="btn" onclick="openOrder('${o.id}')">Details</button>
          </td>
        </tr>
      `).join("") : `<tr><td colspan="11">${empty("ما لقيت حتى order")}</td></tr>`;
    }

    async function updateStatus(id, field, value) {
      try {
        const res = await api("updateOrder", { id, field, value });
        if (!res.success) return toast("Error", res.error || "Update error");

        toast("تم التعديل", `${id} → ${value}`);
        await refreshAll();

      } catch (err) {
        toast("Error", err.message);
      }
    }

    async function openOrder(id) {
      const res = await api("orderDetails", { id });
      if (!res.success) return toast("Error", res.error || "Order not found");

      const o = res.order;

      document.getElementById("modal").innerHTML = `
        <div class="section-head">
          <div>
            <h3>Order Details</h3>
            <span>${o.id}</span>
          </div>
          <button class="btn" onclick="hideModal()">✕</button>
        </div>

        <div class="grid two-grid">
          <div class="card" style="box-shadow:none">
            <h3 style="margin-top:0">${escapeHtml(o.name)}</h3>
            <p class="pill">📞 ${escapeHtml(o.phone)}</p>
            <p class="pill">🏙️ ${escapeHtml(o.city)}</p>
            <p class="pill">📅 ${formatDate(o.date)}</p>
          </div>

          <div class="card" style="box-shadow:none">
            <h3 style="margin-top:0">${escapeHtml(o.product)}</h3>
            <p style="color:var(--muted)">${escapeHtml(o.variant)}</p>
            <p class="pill">💰 ${formatNum(o.price)} ${STATE.config.currency}</p>
            <p>${statusBadge(o.confirmation)} ${statusBadge(o.delivered)}</p>
          </div>
        </div>

        <div class="card" style="box-shadow:none;margin-top:12px">
          <h3 style="margin-top:0">Actions</h3>
          <button class="btn btn-success" onclick="updateStatus('${o.id}','Confirmation','Confirmer');hideModal()">Confirmer</button>
          <button class="btn btn-danger" onclick="updateStatus('${o.id}','Confirmation','Annuler');hideModal()">Annuler</button>
          <button class="btn btn-warning" onclick="updateStatus('${o.id}','Confirmation','Pas de réponse');hideModal()">Pas de réponse</button>
          <button class="btn btn-info" onclick="updateStatus('${o.id}','Delivred','Livrée');hideModal()">Livrée</button>
          <button class="btn btn-warning" onclick="updateStatus('${o.id}','Delivred','Reportée');hideModal()">Reportée</button>
        </div>
      `;

      document.getElementById("modalBackdrop").classList.add("show");
    }

    function closeModal(e) {
      if (e.target.id === "modalBackdrop") hideModal();
    }

    function hideModal() {
      document.getElementById("modalBackdrop").classList.remove("show");
    }

    async function loadCalendar(silent = false) {
      const data = await api("calendar");
      if (!data.success) return toast("Error", data.error || "Calendar error");

      STATE.calendarDays = data.days || [];
      renderCalendar();
    }

    function renderCalendar() {
      const grid = document.getElementById("calendarGrid");
      const date = new Date(STATE.currentMonth);
      const year = date.getFullYear();
      const month = date.getMonth();

      const first = new Date(year, month, 1);
      const last = new Date(year, month + 1, 0);
      const startOffset = (first.getDay() + 6) % 7;

      const monthNames = [
        "يناير", "فبراير", "مارس", "أبريل", "ماي", "يونيو",
        "يوليوز", "غشت", "شتنبر", "أكتوبر", "نونبر", "دجنبر"
      ];
      const dayNames = ["الإثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت", "الأحد"];

      document.getElementById("calendarTitle").textContent = `${monthNames[month]} ${year}`;

      let html = dayNames.map(d => `<div class="day-name">${d}</div>`).join("");

      for (let i = 0; i < startOffset; i++) {
        html += `<div class="day empty"></div>`;
      }

      for (let d = 1; d <= last.getDate(); d++) {
        const key = `${year}-${pad(month + 1)}-${pad(d)}`;
        const dayData = STATE.calendarDays.find(x => x.date === key);
        const active = STATE.selectedDate === key ? "active" : "";

        html += `
          <div class="day ${active}" onclick="selectDay('${key}')">
            <div class="day-num">${d}</div>
            ${dayData ? `
              <span class="day-count">${dayData.total} orders</span>
              <div style="margin-top:7px;color:var(--muted);font-size:12px;font-weight:800">
                ✅ ${dayData.confirmed} | 🚚 ${dayData.delivered}
              </div>
            ` : `<small style="color:var(--muted)">0 order</small>`}
          </div>
        `;
      }

      grid.innerHTML = html;
      renderSelectedDay();
    }

    function selectDay(key) {
      STATE.selectedDate = key;
      renderCalendar();
    }

    function renderSelectedDay() {
      const box = document.getElementById("dayOrders");
      const title = document.getElementById("selectedDayTitle");
      const sub = document.getElementById("selectedDaySub");

      if (!STATE.selectedDate) {
        title.textContent = "اختار نهار";
        sub.textContent = "orders ديال النهار يبانوا هنا";
        box.innerHTML = empty("ما مختار حتى نهار");
        return;
      }

      const day = STATE.calendarDays.find(x => x.date === STATE.selectedDate);

      title.textContent = STATE.selectedDate;
      sub.textContent = day ? `${day.total} orders • ${formatNum(day.revenue)} ${STATE.config.currency}` : "0 order";

      if (!day || !day.orders.length) {
        box.innerHTML = empty("هاد النهار ما فيه حتى order");
        return;
      }

      box.innerHTML = day.orders.map(o => `
        <div class="list-item" onclick="openOrder('${o.id}')" style="cursor:pointer">
          <div>
            <strong>${escapeHtml(o.name)} — ${formatNum(o.price)} ${STATE.config.currency}</strong>
            <small>${escapeHtml(o.city)} • ${escapeHtml(o.product)}</small>
          </div>
          <div>${statusBadge(o.confirmation)}</div>
        </div>
      `).join("");
    }

    function changeMonth(delta) {
      STATE.currentMonth = new Date(
        STATE.currentMonth.getFullYear(),
        STATE.currentMonth.getMonth() + delta,
        1
      );
      renderCalendar();
    }

    function goToday() {
      STATE.currentMonth = new Date();
      STATE.selectedDate = todayKey();
      renderCalendar();
    }

    async function loadProducts(silent = false) {
      const data = await api("products");
      if (!data.success) return toast("Error", data.error || "Products error");

      STATE.products = data.products || [];
      renderProducts();
    }

    function renderProducts() {
      document.getElementById("productsGrid").innerHTML = STATE.products.length ? STATE.products.map(p => `
        <div class="card product-card">
          <div class="product-img">
            ${p.image ? `<img src="${escapeAttr(p.image)}" alt="">` : `<span>صورة المنتج</span>`}
          </div>
          <div class="product-body">
            <h4>${escapeHtml(p.name)}</h4>
            <div class="mini-stats">
              <div class="mini">
                <strong>${p.orders}</strong>
                <small>Orders</small>
              </div>
              <div class="mini">
                <strong>${p.delivered}</strong>
                <small>Delivered</small>
              </div>
              <div class="mini">
                <strong>${formatNum(p.revenue)}</strong>
                <small>DH</small>
              </div>
            </div>
          </div>
        </div>
      `).join("") : empty("ما كايناش products");
    }

    async function loadNotifications(silent = false) {
      const data = await api("notifications");
      if (!data.success) return toast("Error", data.error || "Notifications error");

      document.getElementById("notificationsList").innerHTML = data.notifications.length ? data.notifications.map(n => `
        <div class="list-item">
          <div>
            <strong>🔔 ${escapeHtml(n.title)}</strong>
            <small>${escapeHtml(n.text)} • ${formatDate(n.date)}</small>
          </div>
          <button class="btn" onclick="openOrder('${n.id}')">Details</button>
        </div>
      `).join("") : empty("ما كايناش notifications");
    }

    function notifyNewOrder(order) {
      if (!order) return;

      const badge = document.getElementById("notifBadge");
      const current = Number(badge.textContent || 0) + 1;

      badge.style.display = "";
      badge.textContent = current;

      toast("Order jdida", `${order.name} • ${order.city} • ${formatNum(order.price)} ${STATE.config.currency}`);
      playPing();
    }

    function clearNotifBadge() {
      const badge = document.getElementById("notifBadge");
      badge.textContent = "0";
      badge.style.display = "none";
      toast("Notifications", "تصفاو notifications.");
    }

    function playPing() {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();

        osc.connect(gain);
        gain.connect(ctx.destination);

        osc.frequency.value = 880;
        gain.gain.value = .04;

        osc.start();
        setTimeout(() => {
          osc.stop();
          ctx.close();
        }, 120);
      } catch (e) {}
    }

    function toggleTheme() {
      const body = document.body;
      const next = body.dataset.theme === "dark" ? "light" : "dark";
      body.dataset.theme = next;
      localStorage.setItem("vm_theme", next);
      if (STATE.dashboard) renderChart(STATE.dashboard.summary.ordersByDay || []);
    }

    function restoreTheme() {
      const theme = localStorage.getItem("vm_theme") || "dark";
      document.body.dataset.theme = theme;
    }

    function toast(title, text) {
      const wrap = document.getElementById("toastWrap");
      const el = document.createElement("div");

      el.className = "toast";
      el.innerHTML = `
        <div style="font-size:22px">✨</div>
        <div>
          <b>${escapeHtml(title)}</b>
          <span>${escapeHtml(text || "")}</span>
        </div>
      `;

      wrap.appendChild(el);

      setTimeout(() => {
        el.style.opacity = "0";
        el.style.transform = "translateY(8px)";
        el.style.transition = ".2s";
      }, 3600);

      setTimeout(() => el.remove(), 4000);
    }

    function statusBadge(value) {
      const s = String(value || "فارغ").trim();
      const l = s.toLowerCase();

      let cls = "info";
      if (l.includes("confirm") || l.includes("livr")) cls = "ok";
      if (l.includes("annul") || l.includes("cancel")) cls = "bad";
      if (l.includes("pas") || l.includes("reponse") || l.includes("réponse") || l.includes("report")) cls = "wait";

      return `<span class="status ${cls}">${escapeHtml(s)}</span>`;
    }

    function formatNum(n) {
      return Number(n || 0).toLocaleString("fr-FR", { maximumFractionDigits: 0 });
    }

    function percent(n) {
      return Math.round(Number(n || 0) * 100) + "%";
    }

    function formatDate(value) {
      if (!value) return "";
      try {
        const d = new Date(value);
        if (isNaN(d.getTime())) return String(value);
        return d.toLocaleString("fr-FR");
      } catch (e) {
        return String(value);
      }
    }

    function empty(text) {
      return `<div style="padding:18px;text-align:center;color:var(--muted);font-weight:900">${text}</div>`;
    }

    function escapeHtml(value) {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function escapeAttr(value) {
      return escapeHtml(value);
    }

    function getMuted() {
      return getComputedStyle(document.body).getPropertyValue("--muted").trim();
    }

    function pad(n) {
      return String(n).padStart(2, "0");
    }

    function todayKey() {
      const d = new Date();
      return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    }

    restoreTheme();
    init();
  </script>
</body>
</html>
