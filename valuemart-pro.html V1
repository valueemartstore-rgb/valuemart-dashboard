
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ValueMart — Orders Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0d0f1a;
    --surface: #131629;
    --surface2: #1a1e35;
    --border: rgba(255,255,255,0.06);
    --accent: #7c5cfc;
    --accent2: #e84393;
    --accent3: #00d4aa;
    --accent4: #f5a623;
    --text: #e8eaf6;
    --muted: #6b7299;
    --danger: #ff4d6d;
    --success: #00d4aa;
    --warn: #f5a623;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Syne', sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* Background grid */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(124,92,252,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(124,92,252,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  .layout {
    display: flex;
    min-height: 100vh;
    position: relative;
    z-index: 1;
  }

  /* SIDEBAR */
  .sidebar {
    width: 240px;
    background: var(--surface);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    padding: 24px 0;
    position: fixed;
    top: 0; left: 0; bottom: 0;
    z-index: 100;
  }

  .logo {
    padding: 0 24px 28px;
    border-bottom: 1px solid var(--border);
  }

  .logo-text {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.5px;
  }

  .logo-text span { color: var(--accent); }

  .logo-sub {
    font-size: 10px;
    color: var(--muted);
    font-family: 'Space Mono', monospace;
    margin-top: 2px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .nav {
    flex: 1;
    padding: 20px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .nav-section-label {
    font-size: 10px;
    color: var(--muted);
    font-family: 'Space Mono', monospace;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 8px 12px 4px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--muted);
    transition: all 0.15s;
    border: 1px solid transparent;
  }

  .nav-item:hover { color: var(--text); background: var(--surface2); }

  .nav-item.active {
    color: var(--accent);
    background: rgba(124,92,252,0.12);
    border-color: rgba(124,92,252,0.2);
  }

  .nav-item svg { width: 16px; height: 16px; flex-shrink: 0; }

  .sidebar-footer {
    padding: 20px 24px;
    border-top: 1px solid var(--border);
  }

  .api-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: var(--muted);
    font-family: 'Space Mono', monospace;
  }

  .status-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--muted);
    flex-shrink: 0;
    transition: background 0.3s;
  }

  .status-dot.live { background: var(--success); box-shadow: 0 0 6px var(--success); }
  .status-dot.error { background: var(--danger); box-shadow: 0 0 6px var(--danger); }

  /* MAIN */
  .main {
    margin-left: 240px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* TOPBAR */
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 32px;
    border-bottom: 1px solid var(--border);
    background: rgba(13,15,26,0.8);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .topbar-left h1 {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.5px;
  }

  .topbar-left p {
    font-size: 12px;
    color: var(--muted);
    margin-top: 2px;
    font-family: 'Space Mono', monospace;
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .date-filter {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 7px 14px;
    font-size: 12px;
    font-family: 'Space Mono', monospace;
    color: var(--muted);
  }

  .date-filter input[type="date"] {
    background: transparent;
    border: none;
    color: var(--text);
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    outline: none;
    cursor: pointer;
    width: 110px;
  }

  input[type="date"]::-webkit-calendar-picker-indicator {
    filter: invert(0.5);
    cursor: pointer;
  }

  .btn-refresh {
    display: flex;
    align-items: center;
    gap: 7px;
    background: var(--accent);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 12.5px;
    font-weight: 700;
    font-family: 'Syne', sans-serif;
    cursor: pointer;
    transition: all 0.15s;
  }

  .btn-refresh:hover { background: #9070ff; transform: translateY(-1px); }
  .btn-refresh:active { transform: translateY(0); }
  .btn-refresh svg { width: 14px; height: 14px; }

  .btn-refresh.loading svg { animation: spin 1s linear infinite; }

  @keyframes spin { to { transform: rotate(360deg); } }

  /* CONTENT */
  .content {
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* STAT CARDS */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }

  .stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
  }

  .stat-card:hover { transform: translateY(-2px); }

  .stat-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    border-radius: 14px 14px 0 0;
  }

  .stat-card.c1::before { background: var(--accent); }
  .stat-card.c2::before { background: var(--accent2); }
  .stat-card.c3::before { background: var(--accent3); }
  .stat-card.c4::before { background: var(--accent4); }
  .stat-card.c5::before { background: var(--danger); }

  .stat-icon {
    width: 36px; height: 36px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
  }

  .stat-icon svg { width: 18px; height: 18px; }

  .stat-card.c1 .stat-icon { background: rgba(124,92,252,0.15); color: var(--accent); }
  .stat-card.c2 .stat-icon { background: rgba(232,67,147,0.15); color: var(--accent2); }
  .stat-card.c3 .stat-icon { background: rgba(0,212,170,0.15); color: var(--accent3); }
  .stat-card.c4 .stat-icon { background: rgba(245,166,35,0.15); color: var(--accent4); }
  .stat-card.c5 .stat-icon { background: rgba(255,77,109,0.15); color: var(--danger); }

  .stat-val {
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1;
    margin-bottom: 4px;
  }

  .stat-label {
    font-size: 11.5px;
    color: var(--muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .stat-sub {
    font-size: 11px;
    color: var(--muted);
    margin-top: 8px;
    font-family: 'Space Mono', monospace;
  }

  /* PANELS ROW */
  .panels-row {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 16px;
  }

  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 22px;
    border-bottom: 1px solid var(--border);
  }

  .panel-title {
    font-size: 14px;
    font-weight: 700;
  }

  .panel-badge {
    font-size: 10px;
    font-family: 'Space Mono', monospace;
    color: var(--muted);
    background: var(--surface2);
    padding: 3px 8px;
    border-radius: 20px;
    border: 1px solid var(--border);
  }

  /* CHART */
  .chart-wrap {
    padding: 20px 22px;
    height: 220px;
    position: relative;
  }

  canvas { display: block; }

  /* DONUT PANELS */
  .donut-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px;
    gap: 16px;
  }

  .donut-wrap {
    position: relative;
    width: 140px; height: 140px;
  }

  .donut-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .donut-center .val {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -1px;
  }

  .donut-center .lbl {
    font-size: 10px;
    color: var(--muted);
    font-family: 'Space Mono', monospace;
    text-transform: uppercase;
  }

  .legend {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .legend-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
  }

  .legend-left {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-weight: 600;
  }

  .legend-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .legend-val {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    color: var(--text);
  }

  /* BOTTOM ROW */
  .bottom-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1.5fr;
    gap: 16px;
  }

  /* TOP LIST */
  .top-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .top-list-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 22px;
    border-bottom: 1px solid var(--border);
    transition: background 0.15s;
  }

  .top-list-item:last-child { border-bottom: none; }
  .top-list-item:hover { background: var(--surface2); }

  .rank {
    font-size: 11px;
    font-family: 'Space Mono', monospace;
    color: var(--muted);
    width: 20px;
    flex-shrink: 0;
  }

  .item-info { flex: 1; min-width: 0; }

  .item-name {
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .item-bar-wrap {
    height: 3px;
    background: var(--surface2);
    border-radius: 2px;
    margin-top: 5px;
    overflow: hidden;
  }

  .item-bar {
    height: 100%;
    border-radius: 2px;
    background: var(--accent);
    transition: width 0.8s cubic-bezier(0.23,1,0.32,1);
  }

  .item-count {
    font-size: 12px;
    font-family: 'Space Mono', monospace;
    color: var(--text);
    flex-shrink: 0;
  }

  /* ORDERS TABLE */
  .orders-table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
  }

  thead th {
    padding: 10px 16px;
    text-align: left;
    font-size: 10px;
    color: var(--muted);
    font-family: 'Space Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }

  tbody tr {
    border-bottom: 1px solid var(--border);
    transition: background 0.12s;
  }

  tbody tr:hover { background: var(--surface2); }
  tbody tr:last-child { border-bottom: none; }

  tbody td {
    padding: 11px 16px;
    color: var(--text);
    vertical-align: middle;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10.5px;
    font-weight: 700;
    font-family: 'Space Mono', monospace;
    padding: 3px 9px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  .badge-confirmed { background: rgba(0,212,170,0.12); color: var(--success); border: 1px solid rgba(0,212,170,0.2); }
  .badge-delivered { background: rgba(124,92,252,0.12); color: var(--accent); border: 1px solid rgba(124,92,252,0.2); }
  .badge-cancelled { background: rgba(255,77,109,0.12); color: var(--danger); border: 1px solid rgba(255,77,109,0.2); }
  .badge-pending { background: rgba(245,166,35,0.12); color: var(--warn); border: 1px solid rgba(245,166,35,0.2); }
  .badge-noreply { background: rgba(107,114,153,0.12); color: var(--muted); border: 1px solid rgba(107,114,153,0.2); }

  /* LOADING SKELETON */
  .skeleton {
    background: linear-gradient(90deg, var(--surface2) 25%, rgba(255,255,255,0.04) 50%, var(--surface2) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    border-radius: 6px;
  }

  @keyframes shimmer { to { background-position: -200% 0; } }

  /* RATE CARDS */
  .rate-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding: 20px 22px;
  }

  .rate-card {
    background: var(--surface2);
    border-radius: 10px;
    padding: 14px;
    text-align: center;
  }

  .rate-val {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.5px;
  }

  .rate-label {
    font-size: 10px;
    color: var(--muted);
    font-family: 'Space Mono', monospace;
    text-transform: uppercase;
    margin-top: 3px;
  }

  /* SCROLLBAR */
  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--surface2); border-radius: 3px; }

  /* FADE-IN */
  .fade-in {
    animation: fadeIn 0.4s ease forwards;
    opacity: 0;
  }

  @keyframes fadeIn { to { opacity: 1; } }

  /* TOAST */
  #toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 18px;
    font-size: 13px;
    font-family: 'Space Mono', monospace;
    color: var(--text);
    transform: translateY(60px);
    opacity: 0;
    transition: all 0.3s;
    z-index: 999;
  }

  #toast.show { transform: translateY(0); opacity: 1; }

  /* Updated timestamp */
  #updated-at {
    font-size: 10px;
    font-family: 'Space Mono', monospace;
    color: var(--muted);
  }
</style>
</head>
<body>

<div class="layout">
  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="logo">
      <div class="logo-text">Value<span>Mart</span></div>
      <div class="logo-sub">Orders Analytics</div>
    </div>
    <nav class="nav">
      <div class="nav-section-label">General</div>
      <div class="nav-item active">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        Vue d'ensemble
      </div>
      <div class="nav-item">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
        Commandes
      </div>
      <div class="nav-item">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 00-2 2v6a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/><circle cx="12" cy="12" r="2"/></svg>
        Produits
      </div>
      <div class="nav-section-label" style="margin-top:8px">Rapports</div>
      <div class="nav-item">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M18 9l-6-6-4 4-3 3"/></svg>
        Livraisons
      </div>
      <div class="nav-item">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
        Historique
      </div>
      <div class="nav-section-label" style="margin-top:8px">Villes</div>
      <div class="nav-item">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        Top Villes
      </div>
    </nav>
    <div class="sidebar-footer">
      <div class="api-status">
        <div class="status-dot" id="status-dot"></div>
        <span id="status-text">Connexion...</span>
      </div>
      <div id="updated-at" style="margin-top:6px">—</div>
    </div>
  </aside>

  <!-- MAIN -->
  <div class="main">
    <!-- TOPBAR -->
    <header class="topbar">
      <div class="topbar-left">
        <h1>Tableau de Bord</h1>
        <p id="filter-label">Toutes les commandes — Youcan Orders</p>
      </div>
      <div class="topbar-right">
        <div class="date-filter">
          <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          <input type="date" id="start-date" placeholder="Début">
          <span style="color:var(--muted)">→</span>
          <input type="date" id="end-date" placeholder="Fin">
        </div>
        <button class="btn-refresh" onclick="loadData()" id="refresh-btn">
          <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M23 4v6h-6"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg>
          Rafraîchir
        </button>
      </div>
    </header>

    <!-- CONTENT -->
    <div class="content" id="content">

      <!-- STAT CARDS -->
      <div class="stats-grid" id="stats-grid">
        <div class="stat-card c1"><div class="stat-icon"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><path d="M3 6h18"/></svg></div><div class="stat-val skeleton" id="s-total" style="width:80px;height:32px"></div><div class="stat-label">Total Commandes</div><div class="stat-sub" id="s-filtered">— filtrées</div></div>
        <div class="stat-card c2"><div class="stat-icon"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg></div><div class="stat-val skeleton" id="s-confirmed" style="width:80px;height:32px"></div><div class="stat-label">Confirmées</div><div class="stat-sub" id="s-conf-rate">— taux conf.</div></div>
        <div class="stat-card c3"><div class="stat-icon"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div><div class="stat-val skeleton" id="s-delivered" style="width:80px;height:32px"></div><div class="stat-label">Livrées</div><div class="stat-sub" id="s-del-rate">— taux liv.</div></div>
        <div class="stat-card c4"><div class="stat-icon"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg></div><div class="stat-val skeleton" id="s-revenue" style="width:80px;height:32px"></div><div class="stat-label">CA Livré (MAD)</div><div class="stat-sub" id="s-aov">— AOV</div></div>
        <div class="stat-card c5"><div class="stat-icon"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></div><div class="stat-val skeleton" id="s-cancelled" style="width:80px;height:32px"></div><div class="stat-label">Annulées</div><div class="stat-sub" id="s-noreply">— sans réponse</div></div>
      </div>

      <!-- CHARTS ROW -->
      <div class="panels-row">
        <div class="panel">
          <div class="panel-header">
            <div class="panel-title">Commandes par Jour</div>
            <div class="panel-badge" id="chart-range">—</div>
          </div>
          <div class="chart-wrap">
            <canvas id="lineChart"></canvas>
          </div>
        </div>
        <div class="panel">
          <div class="panel-header">
            <div class="panel-title">Statut Confirmation</div>
            <div class="panel-badge" id="conf-total-badge">—</div>
          </div>
          <div class="donut-panel">
            <div class="donut-wrap">
              <canvas id="donutConf" width="140" height="140"></canvas>
              <div class="donut-center">
                <div class="val" id="donut-conf-val">—</div>
                <div class="lbl">Conf. %</div>
              </div>
            </div>
            <div class="legend" id="conf-legend"></div>
          </div>
        </div>
      </div>

      <!-- BOTTOM ROW -->
      <div class="bottom-row">
        <div class="panel">
          <div class="panel-header">
            <div class="panel-title">🏙 Top Villes</div>
            <div class="panel-badge">Top 5</div>
          </div>
          <div class="top-list" id="cities-list"></div>
        </div>
        <div class="panel">
          <div class="panel-header">
            <div class="panel-title">📦 Top Produits</div>
            <div class="panel-badge">Top 5</div>
          </div>
          <div class="top-list" id="products-list"></div>
        </div>
        <div class="panel">
          <div class="panel-header">
            <div class="panel-title">Commandes Récentes</div>
            <div class="panel-badge" id="orders-count-badge">—</div>
          </div>
          <div class="orders-table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Client</th>
                  <th>Ville</th>
                  <th>Produit</th>
                  <th>Prix</th>
                  <th>Confirm.</th>
                  <th>Livraison</th>
                </tr>
              </thead>
              <tbody id="orders-tbody"></tbody>
            </table>
          </div>
        </div>
      </div>

    </div><!-- /content -->
  </div><!-- /main -->
</div>

<div id="toast"></div>

<script>
const API_URL = 'https://script.google.com/macros/s/AKfycbzFgNkVD2pQy9U9LRfJlTrpk0tNQPMSoMmWH483ZCgfKmpFy3ArsQr5EV77AvzaBrleIw/exec';

let lineChartInst = null;
let donutConfInst = null;

function showToast(msg, duration = 3000) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), duration);
}

async function loadData() {
  const btn = document.getElementById('refresh-btn');
  btn.classList.add('loading');
  setStatus('loading');

  const startDate = document.getElementById('start-date').value;
  const endDate = document.getElementById('end-date').value;

  let url = API_URL;
  const params = [];
  if (startDate) params.push('start=' + startDate);
  if (endDate) params.push('end=' + endDate);
  if (params.length) url += '?' + params.join('&');

  try {
    const res = await fetch(url);
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const data = await res.json();

    if (!data.success) throw new Error(data.error || 'API error');

    renderDashboard(data);
    setStatus('live');
    showToast('✓ Données actualisées');

    const d = new Date(data.updatedAt);
    document.getElementById('updated-at').textContent = d.toLocaleTimeString('fr-FR');
  } catch (e) {
    console.error(e);
    setStatus('error');
    showToast('✗ Erreur: ' + e.message, 5000);
  } finally {
    btn.classList.remove('loading');
  }
}

function setStatus(s) {
  const dot = document.getElementById('status-dot');
  const txt = document.getElementById('status-text');
  dot.className = 'status-dot ' + (s === 'live' ? 'live' : s === 'error' ? 'error' : '');
  txt.textContent = s === 'live' ? 'En ligne' : s === 'error' ? 'Erreur' : 'Chargement...';
}

function fmtNum(n) {
  if (n === undefined || n === null) return '—';
  return Number(n).toLocaleString('fr-FR');
}

function pct(v) {
  return (v * 100).toFixed(1) + '%';
}

function fmtDate(str) {
  if (!str) return '—';
  const d = new Date(str);
  if (isNaN(d)) return String(str).slice(0, 10);
  return d.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit' });
}

function renderDashboard(data) {
  const s = data.summary;

  // STAT CARDS
  setText('s-total', fmtNum(data.totalRows));
  setText('s-filtered', fmtNum(data.filteredRows) + ' filtrées');
  setText('s-confirmed', fmtNum(s.confirmed));
  setText('s-conf-rate', pct(s.confirmationRate) + ' taux conf.');
  setText('s-delivered', fmtNum(s.delivered));
  setText('s-del-rate', pct(s.deliveryRate) + ' taux liv.');
  setText('s-revenue', fmtNum(Math.round(s.revenueDelivered)));
  setText('s-aov', 'AOV ' + fmtNum(Math.round(s.realAovDelivered)) + ' MAD');
  setText('s-cancelled', fmtNum(s.cancelled));
  setText('s-noreply', fmtNum(s.noResponse) + ' sans réponse');

  // Remove skeleton classes
  ['s-total','s-confirmed','s-delivered','s-revenue','s-cancelled'].forEach(id => {
    const el = document.getElementById(id);
    el.classList.remove('skeleton');
    el.style.width = '';
    el.style.height = '';
  });

  // Filter label
  const f = data.filters;
  if (f.start || f.end) {
    document.getElementById('filter-label').textContent =
      'Filtré: ' + (f.start || '...') + ' → ' + (f.end || '...');
  } else {
    document.getElementById('filter-label').textContent = 'Toutes les commandes — Youcan Orders';
  }

  // LINE CHART
  renderLineChart(s.ordersByDay);

  // DONUT CONF
  renderDonutConf(s.confirmationStatus, s.confirmationRate);

  // CITIES
  renderTopList('cities-list', s.topCities, '#7c5cfc');

  // PRODUCTS
  const shortProducts = (s.topProducts || []).map(p => ({
    ...p,
    name: p.name.replace(/[🌸]/g, '').trim().slice(0, 30)
  }));
  renderTopList('products-list', shortProducts, '#e84393');

  // ORDERS TABLE
  renderOrdersTable(data.orders);

  setText('orders-count-badge', (data.orders || []).length + ' récentes');
}

function setText(id, val) {
  const el = document.getElementById(id);
  if (el) el.textContent = val;
}

function renderLineChart(ordersByDay) {
  const ctx = document.getElementById('lineChart').getContext('2d');

  // Responsive size
  const canvas = document.getElementById('lineChart');
  const wrap = canvas.parentElement;
  canvas.width = wrap.offsetWidth;
  canvas.height = wrap.offsetHeight;

  if (lineChartInst) { lineChartInst = null; }

  if (!ordersByDay || !ordersByDay.length) {
    ctx.fillStyle = '#6b7299';
    ctx.font = '13px Syne';
    ctx.textAlign = 'center';
    ctx.fillText('Aucune donnée', canvas.width / 2, canvas.height / 2);
    return;
  }

  const W = canvas.width, H = canvas.height;
  const pad = { top: 16, right: 20, bottom: 40, left: 46 };
  const chartW = W - pad.left - pad.right;
  const chartH = H - pad.top - pad.bottom;

  const maxVal = Math.max(...ordersByDay.map(d => d.count));
  const minVal = 0;

  // Pick label step
  const step = Math.max(1, Math.floor(ordersByDay.length / 8));

  ctx.clearRect(0, 0, W, H);

  // Grid lines
  const yTicks = 4;
  for (let i = 0; i <= yTicks; i++) {
    const y = pad.top + chartH - (i / yTicks) * chartH;
    ctx.beginPath();
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    ctx.moveTo(pad.left, y);
    ctx.lineTo(pad.left + chartW, y);
    ctx.stroke();

    // Y label
    ctx.fillStyle = '#6b7299';
    ctx.font = '10px Space Mono, monospace';
    ctx.textAlign = 'right';
    ctx.fillText(Math.round((i / yTicks) * maxVal), pad.left - 6, y + 4);
  }

  // Build path
  const pts = ordersByDay.map((d, i) => ({
    x: pad.left + (i / (ordersByDay.length - 1 || 1)) * chartW,
    y: pad.top + chartH - ((d.count - minVal) / (maxVal - minVal || 1)) * chartH
  }));

  // Fill gradient
  const grad = ctx.createLinearGradient(0, pad.top, 0, pad.top + chartH);
  grad.addColorStop(0, 'rgba(124,92,252,0.3)');
  grad.addColorStop(1, 'rgba(124,92,252,0)');

  ctx.beginPath();
  ctx.moveTo(pts[0].x, pts[0].y);
  for (let i = 1; i < pts.length; i++) {
    const cp1x = (pts[i - 1].x + pts[i].x) / 2;
    ctx.bezierCurveTo(cp1x, pts[i - 1].y, cp1x, pts[i].y, pts[i].x, pts[i].y);
  }
  ctx.lineTo(pts[pts.length - 1].x, pad.top + chartH);
  ctx.lineTo(pts[0].x, pad.top + chartH);
  ctx.closePath();
  ctx.fillStyle = grad;
  ctx.fill();

  // Line
  ctx.beginPath();
  ctx.moveTo(pts[0].x, pts[0].y);
  for (let i = 1; i < pts.length; i++) {
    const cp1x = (pts[i - 1].x + pts[i].x) / 2;
    ctx.bezierCurveTo(cp1x, pts[i - 1].y, cp1x, pts[i].y, pts[i].x, pts[i].y);
  }
  ctx.strokeStyle = '#7c5cfc';
  ctx.lineWidth = 2.5;
  ctx.stroke();

  // Dots & X labels
  pts.forEach((p, i) => {
    ctx.beginPath();
    ctx.arc(p.x, p.y, 3, 0, Math.PI * 2);
    ctx.fillStyle = '#7c5cfc';
    ctx.fill();

    if (i % step === 0 || i === pts.length - 1) {
      ctx.fillStyle = '#6b7299';
      ctx.font = '9px Space Mono, monospace';
      ctx.textAlign = 'center';
      const label = ordersByDay[i].date.slice(5); // MM-DD
      ctx.fillText(label, p.x, pad.top + chartH + 14);
    }
  });

  // Chart range badge
  if (ordersByDay.length > 0) {
    const first = ordersByDay[0].date;
    const last = ordersByDay[ordersByDay.length - 1].date;
    document.getElementById('chart-range').textContent = first.slice(5) + ' → ' + last.slice(5);
  }
}

function renderDonutConf(statusArr, confRate) {
  if (!statusArr || !statusArr.length) return;

  // Map to 4 categories
  const cats = [
    { key: 'confirmer', label: 'Confirmé', color: '#00d4aa' },
    { key: 'annuler', label: 'Annulé', color: '#ff4d6d' },
    { key: 'reponse', label: 'Sans Rép.', color: '#6b7299' },
    { key: 'other', label: 'Autre', color: '#f5a623' },
  ];

  let confirmed = 0, cancelled = 0, noreply = 0, other = 0;
  statusArr.forEach(s => {
    const v = s.name.toLowerCase();
    if (v.includes('confirmer')) confirmed += s.count;
    else if (v.includes('annuler')) cancelled += s.count;
    else if (v.includes('reponse') || v.includes('réponse') || v.includes('reminder') || v.includes('appel')) noreply += s.count;
    else other += s.count;
  });

  const vals = [confirmed, cancelled, noreply, other];
  const total = vals.reduce((a, b) => a + b, 0);

  // Donut canvas
  const canvas = document.getElementById('donutConf');
  const ctx = canvas.getContext('2d');
  ctx.clearRect(0, 0, 140, 140);

  const cx = 70, cy = 70, r = 56, ir = 40;
  let angle = -Math.PI / 2;

  vals.forEach((val, i) => {
    if (!val) return;
    const slice = (val / total) * 2 * Math.PI;
    ctx.beginPath();
    ctx.moveTo(cx, cy);
    ctx.arc(cx, cy, r, angle, angle + slice);
    ctx.fillStyle = cats[i].color;
    ctx.fill();
    angle += slice;
  });

  // Inner hole
  ctx.beginPath();
  ctx.arc(cx, cy, ir, 0, 2 * Math.PI);
  ctx.fillStyle = '#131629';
  ctx.fill();

  // Center value
  document.getElementById('donut-conf-val').textContent = pct(confRate);
  document.getElementById('conf-total-badge').textContent = fmtNum(total);

  // Legend
  const legend = document.getElementById('conf-legend');
  legend.innerHTML = '';
  [confirmed, cancelled, noreply, other].forEach((val, i) => {
    if (!val) return;
    const item = document.createElement('div');
    item.className = 'legend-item';
    const pctVal = total ? ((val / total) * 100).toFixed(1) : '0';
    item.innerHTML = `
      <div class="legend-left">
        <div class="legend-dot" style="background:${cats[i].color}"></div>
        ${cats[i].label}
      </div>
      <div class="legend-val">${fmtNum(val)} (${pctVal}%)</div>
    `;
    legend.appendChild(item);
  });
}

function renderTopList(containerId, items, barColor) {
  const container = document.getElementById(containerId);
  container.innerHTML = '';
  if (!items || !items.length) {
    container.innerHTML = '<div style="padding:20px;color:var(--muted);font-size:12px">Aucune donnée</div>';
    return;
  }
  const top5 = items.slice(0, 5);
  const max = top5[0].count;
  top5.forEach((item, i) => {
    const pctW = max ? Math.round((item.count / max) * 100) : 0;
    const el = document.createElement('div');
    el.className = 'top-list-item fade-in';
    el.style.animationDelay = (i * 0.07) + 's';
    el.innerHTML = `
      <div class="rank">${String(i + 1).padStart(2, '0')}</div>
      <div class="item-info">
        <div class="item-name">${item.name}</div>
        <div class="item-bar-wrap">
          <div class="item-bar" style="width:0;background:${barColor}" data-target="${pctW}"></div>
        </div>
      </div>
      <div class="item-count">${fmtNum(item.count)}</div>
    `;
    container.appendChild(el);
    setTimeout(() => {
      const bar = el.querySelector('.item-bar');
      if (bar) bar.style.width = pctW + '%';
    }, 100 + i * 70);
  });
}

function getBadgeClass(val) {
  if (!val) return '';
  const v = String(val).toLowerCase();
  if (v.includes('confirmer')) return 'badge-confirmed';
  if (v.includes('annuler')) return 'badge-cancelled';
  if (v.includes('livree') || v.includes('livrée')) return 'badge-delivered';
  if (v.includes('reporte') || v.includes('reporté')) return 'badge-pending';
  if (v.includes('reponse') || v.includes('réponse')) return 'badge-noreply';
  return 'badge-noreply';
}

function renderOrdersTable(orders) {
  const tbody = document.getElementById('orders-tbody');
  tbody.innerHTML = '';
  if (!orders || !orders.length) {
    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:var(--muted);padding:30px">Aucune commande</td></tr>';
    return;
  }
  orders.slice(0, 15).forEach((o, i) => {
    const tr = document.createElement('tr');
    tr.className = 'fade-in';
    tr.style.animationDelay = (i * 0.03) + 's';

    const confClass = getBadgeClass(o.confirmation);
    const delivClass = getBadgeClass(o.delivered);

    tr.innerHTML = `
      <td style="font-family:'Space Mono',monospace;font-size:11px;color:var(--muted)">${fmtDate(o.date)}</td>
      <td style="font-weight:600">${o.name || '—'}</td>
      <td style="color:var(--muted)">${o.city || '—'}</td>
      <td style="color:var(--muted);max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${(o.product || '').replace(/[🌸]/g, '').trim().slice(0, 25)}</td>
      <td style="font-family:'Space Mono',monospace;font-size:11px;color:var(--accent4)">${o.price ? fmtNum(o.price) + ' DH' : '—'}</td>
      <td><span class="badge ${confClass}">${o.confirmation || '—'}</span></td>
      <td><span class="badge ${delivClass}">${o.delivered || '—'}</span></td>
    `;
    tbody.appendChild(tr);
  });
}

// Load on init
window.addEventListener('load', () => {
  loadData();
  window.addEventListener('resize', () => {
    // re-render chart on resize
    if (window._lastData) renderLineChart(window._lastData.summary.ordersByDay);
  });
});

// Wrap renderDashboard to cache data
const _origRender = renderDashboard;
window.renderDashboard = function(data) {
  window._lastData = data;
  _origRender(data);
};
</script>
</body>
</html>
